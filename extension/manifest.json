{
  "manifest_version": 3,
  "name": "WebAuthn Browser Request Broker",
  "version": "1.0.29",
  "minimum_chrome_version": "115",
  "key": "",
  "permissions": [
    "webAuthenticationProxy",
    "nativeMessaging",
    "alarms",
    "webNavigation",
    "webRequest",
    "tabs",
    "tabGroups"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
